{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "outDir": "out",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": { "vscode": ["../src/vscode-dts/vscode.d.ts"] },
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
